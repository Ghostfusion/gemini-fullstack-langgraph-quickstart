# -------------------------
# Google Search Tool Configuration
# -------------------------
# Required: Gemini API Key for the Google Search tool
GEMINI_API_KEY=your_gemini_api_key_here

# -------------------------
# Ollama LLM Configuration
# -------------------------
# Optional: Base URL for your Ollama instance (defaults to http://localhost:11434 in code)
OLLAMA_BASE_URL=http://localhost:11434

# Optional: Specify the Ollama model for the query generator (defaults to ollama-model in code)
# Example: QUERY_GENERATOR_MODEL=llama3:latest
QUERY_GENERATOR_MODEL=

# Optional: Specify the Ollama model for reflection (defaults to ollama-model in code)
# Example: REFLECTION_MODEL=llama3:latest
REFLECTION_MODEL=

# Optional: Specify the Ollama model for the final answer generation (defaults to ollama-model in code)
# Example: ANSWER_MODEL=llama3:latest
ANSWER_MODEL=